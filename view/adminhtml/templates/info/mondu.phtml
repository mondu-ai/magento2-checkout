<?php

declare(strict_types=1);

/**
 * Mondu payment information in the admin: the method title, then each detail as its own
 * line, the way the order view lists the order currency below it.
 *
 * @var \Mondu\Mondu\Block\Info $block
 * @var \Magento\Framework\Escaper $escaper
 */

$order = $block->getInfo()->getOrder();
$paymentTitle = $block->getMethod()->getConfigData('title', $order ? $order->getStoreId() : null);
?>
<?= $escaper->escapeHtml($paymentTitle) ?>
<?php foreach ($block->getSpecificInformation() as $label => $value): ?>
    <div class="mondu-payment-info">
        <?= $escaper->escapeHtml($label) ?>:
        <?= $escaper->escapeHtml(implode(', ', $block->getValueAsArray($value, true))) ?>
    </div>
<?php endforeach; ?>
<?= $block->getChildHtml() ?>
