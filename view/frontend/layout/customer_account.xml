<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="customer_account_navigation">
            <block class="Mondu\Mondu\Block\Customer\Account\MonduLink"
                   name="customer-account-navigation-mondu-buyer"
                   after="customer-account-navigation-payment-methods">
                <arguments>
                    <argument name="path" xsi:type="string">mondu/buyer/index</argument>
                    <argument name="label" xsi:type="string" translate="true">Mondu Trade Account</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
